# Console dev env (copy to .env.local — NOT committed).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=   # anon key de `supabase status`

# DEV-SHIM ONLY (F1-04). A pre-minted tenant JWT so the browser reads brain_events
# under RLS before real auth exists. The real path is GitHub OAuth → JWT with a
# `tenant` claim (a later auth task) — then this var goes away. Mint one with:
#   node scripts/mint-dev-jwt.mjs <tenant-uuid>
NEXT_PUBLIC_DEV_TENANT_JWT=
NEXT_PUBLIC_DEV_PROJECT_ID=   # uuid del proyecto a mostrar en el explorer
