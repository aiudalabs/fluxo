name: test-verify

# EJECUTA la suite de tests DEL REPO (Sprint P1-2, cierra L-AUTO-3 / docs/10 #6). `suite-integrity`
# solo CUENTA marcadores; `claude-review` juzga honestidad; ESTE workflow los EJECUTA. Un test rojo
# FALLA el check y bloquea el merge. Sin él, "los tests pasan" no es evidencia.
#
# STACK python-fastapi-react: backend FastAPI (pytest) + frontend React (npm/vitest). Corre AMBAS
# suites; cada tramo se saltea limpio si su carpeta no existe (aditivo). BLOQUEANTE (sin continue-on-error).

on:
  pull_request:

permissions:
  contents: read

jobs:
  backend-tests:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Detect backend tests
        id: cfg
        run: |
          if [ -d backend ] && { [ -f backend/pyproject.toml ] || [ -f backend/requirements.txt ]; }; then
            echo "present=true" >> "$GITHUB_OUTPUT"
          else
            echo "present=false" >> "$GITHUB_OUTPUT"
            echo "test-verify(backend): no backend/ python project — skipping."
          fi

      - name: Set up Python
        if: steps.cfg.outputs.present == 'true'
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install + run pytest (blocking)
        if: steps.cfg.outputs.present == 'true'
        working-directory: backend
        run: |
          set -euo pipefail
          python -m pip install --upgrade pip
          if [ -f pyproject.toml ]; then pip install -e ".[dev]" || pip install -e .; fi
          if [ -f requirements.txt ]; then pip install -r requirements.txt; fi
          if [ -f requirements-dev.txt ]; then pip install -r requirements-dev.txt; fi
          pip install pytest
          pytest

  frontend-tests:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Detect frontend tests
        id: cfg
        run: |
          if [ -f frontend/package.json ] && grep -q '"test"[[:space:]]*:' frontend/package.json; then
            echo "present=true" >> "$GITHUB_OUTPUT"
          else
            echo "present=false" >> "$GITHUB_OUTPUT"
            echo "test-verify(frontend): no frontend/ test script — skipping."
          fi

      - name: Set up Node
        if: steps.cfg.outputs.present == 'true'
        uses: actions/setup-node@v4
        with:
          node-version: "20"

      - name: Install + run the suite (blocking)
        if: steps.cfg.outputs.present == 'true'
        working-directory: frontend
        run: |
          set -euo pipefail
          if [ -f pnpm-lock.yaml ]; then corepack enable && pnpm install --frozen-lockfile && pnpm test
          elif [ -f yarn.lock ]; then corepack enable && yarn install --frozen-lockfile && yarn test
          else npm ci && npm test; fi
