name: build-apk

# Build del APK de release como job de CI DETERMINISTA — NO trabajo del agente. El
# agente implementa código + tests; empaquetar el binario de la app es un paso
# reproducible de CI, no algo que Claude/Copilot deba lanzar en background dentro de
# su propio runner efímero (ahí el turno termina, la sesión muere y el build queda
# colgado sin producir nada). Dispará esto a mano (workflow_dispatch) o con un tag de
# versión; el .apk queda como artifact del run.

on:
  workflow_dispatch: {}
  push:
    tags:
      - "v*"

permissions:
  contents: read

env:
  # App a empaquetar (misma variable que ui-verify; el generador la sustituye,
  # default apps/customer).
  APP_PATH: "{{app_path}}"
  FIREBASE_APP_ID: ${{ secrets.FIREBASE_APP_ID }}   # gate de distribución (env → válido en if:)

jobs:
  build-apk:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      # Guard hashFiles (mismo patrón defensivo que ui-verify / copilot-setup-steps):
      # si la app no existe en el árbol, cada paso se salta y el job pasa en verde.
      - name: Set up Flutter
        if: ${{ hashFiles('{{app_path}}/pubspec.yaml') != '' }}
        uses: subosito/flutter-action@v2
        with:
          channel: stable
          cache: true

      # gradle de Android necesita un JDK; 21 es el mismo runtime que declara el
      # contrato del stack (.fluxo/verify/stack.verify.yaml → ci_setup.java).
      - name: Set up Java (Android build toolchain)
        if: ${{ hashFiles('{{app_path}}/pubspec.yaml') != '' }}
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "21"

      - name: Bootstrap Dart workspace (melos, best-effort)
        if: ${{ hashFiles('{{app_path}}/pubspec.yaml') != '' }}
        run: |
          set -euo pipefail
          export PATH="$PATH:$HOME/.pub-cache/bin"
          # melos linkea el workspace; si falla, `flutter build` corre pub get igual.
          dart pub global activate melos >/dev/null 2>&1 || true
          melos bootstrap || echo "melos bootstrap best-effort falló; seguimos (flutter build hará pub get)."

      # Firma de release (Sprint P3 / F8-03): si el cliente sembró su keystore en secrets, firmamos
      # con él (APK distribuible de verdad). BYO-credencial: sin keystore → cae a la firma debug
      # (artefacto interno instalable), aditivo. Secrets: ANDROID_KEYSTORE_BASE64,
      # ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS, ANDROID_KEY_PASSWORD.
      - name: Configure release signing (si hay keystore)
        id: signing
        if: ${{ hashFiles('{{app_path}}/pubspec.yaml') != '' }}
        working-directory: ${{ env.APP_PATH }}
        env:
          KS_B64: ${{ secrets.ANDROID_KEYSTORE_BASE64 }}
          KS_PASS: ${{ secrets.ANDROID_KEYSTORE_PASSWORD }}
          KEY_ALIAS: ${{ secrets.ANDROID_KEY_ALIAS }}
          KEY_PASS: ${{ secrets.ANDROID_KEY_PASSWORD }}
        run: |
          set -euo pipefail
          if [ -z "$KS_B64" ]; then
            echo "signed=false" >> "$GITHUB_OUTPUT"
            echo "build-apk: sin ANDROID_KEYSTORE_BASE64 — firma debug (artefacto interno)."
            exit 0
          fi
          echo "$KS_B64" | base64 -d > android/app/release.keystore
          cat > android/key.properties <<EOF
          storeFile=release.keystore
          storePassword=$KS_PASS
          keyAlias=$KEY_ALIAS
          keyPassword=$KEY_PASS
          EOF
          echo "signed=true" >> "$GITHUB_OUTPUT"
          echo "build-apk: keystore configurado — firma de release real."

      - name: Build release APK
        if: ${{ hashFiles('{{app_path}}/pubspec.yaml') != '' }}
        working-directory: ${{ env.APP_PATH }}
        # Con key.properties presente (paso anterior), el módulo Gradle del template firma con el
        # keystore real; sin él, --release cae a la clave debug (APK instalable interno).
        run: flutter build apk --release

      - name: Upload APK artifact
        if: ${{ hashFiles('{{app_path}}/pubspec.yaml') != '' }}
        uses: actions/upload-artifact@v4
        with:
          name: app-release-apk
          path: ${{ env.APP_PATH }}/build/app/outputs/flutter-apk/*.apk
          if-no-files-found: error

      # Distribución a link de prueba (Sprint P3 / F8-03): si hay Firebase App Distribution
      # configurado, subimos el APK a un grupo de testers → link instalable. BYO-credencial: sin
      # FIREBASE_APP_ID → skip (queda el artifact del run). Secrets: FIREBASE_APP_ID (el app id de
      # Firebase) + FIREBASE_SERVICE_ACCOUNT (el MISMO secret umbrella de la capability que usan deploy/
      # device-verify; para App Distribution el SA necesita el rol Firebase App Distribution Admin,
      # roles/firebaseappdistro.admin — ver registry/capabilities/firebase.yaml).
      - name: Distribute to Firebase App Distribution (si está configurado)
        if: ${{ hashFiles('{{app_path}}/pubspec.yaml') != '' && env.FIREBASE_APP_ID != '' }}
        uses: wzieba/Firebase-Distribution-Github-Action@v1
        with:
          appId: ${{ secrets.FIREBASE_APP_ID }}
          serviceCredentialsFileContent: ${{ secrets.FIREBASE_SERVICE_ACCOUNT }}
          groups: testers
          file: ${{ env.APP_PATH }}/build/app/outputs/flutter-apk/app-release.apk
