# Fluxo v2 — variables de entorno (copiar a .env; NO commitear .env)
# Se completa en F0-02 (provisionar Supabase). Valores placeholder — reemplazar por los reales.

# --- Supabase (sustrato) ---
SUPABASE_URL=                 # TODO: url del proyecto Supabase
SUPABASE_ANON_KEY=            # TODO: anon key (para la consola)
SUPABASE_SERVICE_ROLE_KEY=    # TODO: service role (solo control/edge, NUNCA en la consola)
SUPABASE_JWT_SECRET=          # TODO: secreto JWT del proyecto — firma los JWT de tenant (brain-mcp). En prod → Vault (L-SEC-3)
DATABASE_URL=                 # TODO: cadena Postgres (migraciones/pgTAP)

# --- brain-mcp (tool MCP de brain-write, F1-02) ---
# El runtime de agentes lanza brain-mcp con el contexto del proyecto inyectado:
FLUXO_TENANT_ID=              # uuid del tenant (inyectado por-proyecto; el agente NO lo elige)
FLUXO_PROJECT_ID=             # uuid del proyecto (inyectado por-proyecto)

# --- GitHub App (multi-tenant) ---
GITHUB_APP_ID=                # TODO
GITHUB_APP_PRIVATE_KEY=       # TODO: PEM — en prod va en Vault, no en env plano (L-SEC-3)
GITHUB_APP_CLIENT_ID=         # TODO
GITHUB_APP_CLIENT_SECRET=     # TODO
GITHUB_WEBHOOK_SECRET=        # TODO

# --- control (API) ---
CONTROL_ADDR=:8080
CONTROL_CORS_ORIGIN=http://localhost:3000

# --- design runtime (Claude Agent SDK, F5-01) ---
CLAUDE_CODE_OAUTH_TOKEN=       # TODO: token OAuth de Claude Code (sk-ant-oat…) — el SDK autentica con él; en prod → Vault

# --- console ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
