# Caddy — TLS automático (Let's Encrypt) + reverse-proxy al console. PUBLIC_DOMAIN lo inyecta el compose
# desde .env.prod (p.ej. fluxo.aiudalabs.com).
{
	# on-demand TLS para los previews efímeros (release v2 · docs/14): Caddy pregunta a este endpoint
	# ANTES de emitir un cert para un `*.sslip.io` → solo emite para previews ACTIVOS (evita emisión
	# ilimitada con SNIs random). El console está en la misma red del compose.
	on_demand_tls {
		ask http://console:3000/api/preview/tls-allow
	}
}

{$PUBLIC_DOMAIN} {
	encode gzip
	reverse_proxy console:3000
}

# Previews efímeros navegables (release v2 · docs/14). `preview-<pid>.<ip>.sslip.io` → el contenedor
# `edge` del preview (derivado por regex del subdominio), que está en la red `fluxo-preview-ingress`
# compartida con este Caddy. sslip.io da DNS wildcard automático a la IP del VPS (cero setup DNS del
# cliente). TLS on-demand gateado por /api/preview/tls-allow. El default es la IP del VPS de prod.
*.{$PREVIEW_BASE_HOST:2.25.78.202.sslip.io} {
	tls {
		on_demand
	}
	@pv host_regexp pv ^preview-([a-z0-9]+)\.
	handle @pv {
		reverse_proxy fluxo-preview-{re.pv.1}-edge-1:80
	}
	handle {
		respond "preview no encontrado o expirado" 404
	}
}
