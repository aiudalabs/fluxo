# Caddy — TLS automático (Let's Encrypt) + reverse-proxy al console. PUBLIC_DOMAIN lo inyecta el compose
# desde .env.prod (p.ej. fluxo.aiudalabs.com).
{
	# on-demand TLS para los previews efímeros (release v2 · docs/14): Caddy pregunta a este endpoint
	# ANTES de emitir un cert para un `*.sslip.io` → solo emite para previews ACTIVOS (evita emisión
	# ilimitada con SNIs random). El console está en la misma red del compose.
	on_demand_tls {
		ask http://console:3000/api/preview/tls-allow
	}
}

{$PUBLIC_DOMAIN} {
	encode gzip
	reverse_proxy console:3000
}

# Previews efímeros navegables (release v2 · docs/14). CATCH-ALL de HTTPS (cualquier host que NO sea el
# dominio principal): así Caddy emite un cert POR-HOST on-demand (un site label `*.…` haría que quiera
# un cert WILDCARD vía DNS-challenge, que no tenemos). Gateado por on_demand_tls → solo previews activos.
# `preview-<pid>.<ip>.sslip.io` → el edge `fluxo-preview-<pid>-edge-1:80` (derivado por regex), que está
# en la red `fluxo-preview-ingress` compartida con este Caddy. sslip.io = DNS wildcard auto a la IP del VPS.
https:// {
	tls {
		on_demand
	}
	@pv header_regexp pv Host ^preview-([a-z0-9]+)\.
	handle @pv {
		reverse_proxy fluxo-preview-{re.pv.1}-edge-1:80
	}
	handle {
		respond "preview no encontrado o expirado" 404
	}
}
