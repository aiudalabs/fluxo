# Fluxo v2 · env de PRODUCCIÓN (VPS + Supabase managed). Copiá a .env.prod y completá.
# NUNCA commitees .env.prod (tiene secretos). Solo este .example va al repo.

# ── Dominio / TLS ────────────────────────────────────────────────────────────
PUBLIC_DOMAIN=fluxo.tudominio.com            # Caddy saca el cert de Let's Encrypt para este dominio
PUBLIC_URL=https://fluxo.tudominio.com       # URL pública (OAuth callback de GitHub, etc.)

# ── Supabase (managed — Project Settings → API) ──────────────────────────────
# Estos DOS se inlinean en el bundle del browser (build-arg del console):
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# Estos son de runtime (server-side):
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   # SECRETO — solo server; el worker/API lo usan
SUPABASE_JWT_SECRET=<jwt-secret>               # Project Settings → API → JWT Settings

# ── GitHub App (la App de Fluxo — Settings → Developer settings → GitHub Apps) ──
GITHUB_APP_ID=<numeric-app-id>
GITHUB_APP_CLIENT_ID=<Iv1...>
GITHUB_APP_CLIENT_SECRET=<client-secret>       # SECRETO
# La private key VA COMO CONTENIDO (no como path) — pegá el PEM completo entre comillas, con \n reales:
#   GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
GITHUB_APP_PRIVATE_KEY=<pem-contents>          # SECRETO
GITHUB_WEBHOOK_SECRET=<webhook-secret>         # opcional hoy (webhooks aún no cableados al conductor)

# ── Claude (solo para el workflow de DISEÑO local; el conductor NO lo usa) ─────
# El costo del CONDUCTOR lo paga el token del CLIENTE en las Actions (BYO). Este es para las
# corridas de diseño idea→backlog que corren el agente en el worker. Opcional si no diseñás en prod.
CLAUDE_CODE_OAUTH_TOKEN=<claude-oauth-token>   # SECRETO
